<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Actionmental" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#EFEBE2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 剪贴板跳板：全透明、无动画，用户只会感觉到一瞬焦点切换。 -->
    <style name="Theme.Actionmental.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
