<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku：唯一的高权限入口。应用本身不申请网络 / 存储 / 通讯录 / 位置。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 只用于一件事：自愈在后台把监听服务写回去时，当场知会用户。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「屏幕常亮」唯一需要的权限：一把屏幕唤醒锁，用户开一次、关一次，不后台自作主张。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 同样只用于一件事：ROM 在重启时关掉无障碍开关，只有开机广播能把进程拉起来补救。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        常驻前台服务。默认关闭，由用户在「后台加固」页明确打开。
        类型只能是 specialUse：这个服务不播放媒体、不同步数据、不定位，
        它唯一的作用是把进程移出「后台」这个桶，好让温控清理策略不再挑中它。
    -->
    <!--
        没有 Shizuku 时的两条降级路，都可以不给，不给时对应功能如实显示「不可用」：
        WRITE_SETTINGS 由用户在系统「修改系统设置」页里开，只用来写旋转那两项
        （accelerometer_rotation / user_rotation）；
        WRITE_SECURE_SETTINGS 只能用 adb 授予一次（pm grant，重启不丢），
        只用来在无障碍开关被 ROM 关掉时把本应用的监听服务写回去。
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 「打开链接」动作需要能解析到系统浏览器 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".ActionmentalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Actionmental">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Actionmental"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.KeyboardAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            常驻前台服务。exported=false：没有任何外部调用者，只有本应用按设置开关它。
            stopWithTask=false：用户从最近任务里划掉界面时，监听服务不该跟着没。
        -->
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the physical-keyboard listener process resident" />
        </service>

        <service
            android:name=".service.ScreenAwakeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screen_awake"
            android:label="@string/tile_screen_awake"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <service
            android:name=".service.ForceLandscapeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_force_landscape"
            android:label="@string/tile_force_landscape"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <service
            android:name=".service.RotationCycleTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_rotation_cycle"
            android:label="@string/tile_rotation_cycle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            directBootAware 保持默认 false：配置存在凭据加密区，锁屏解锁前根本读不到，
            提前收到广播只会白跑一趟。
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 常亮通知上的「关闭常亮」按钮。只有本应用发得出这条广播。 -->
        <receiver
            android:name=".service.ScreenAwakeReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
